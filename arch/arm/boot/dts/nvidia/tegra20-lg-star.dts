/dts-v1/;

#include <dt-bindings/input/gpio-keys.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/thermal/thermal.h>

#include "tegra20.dtsi"
#include "tegra20-cpu-opp.dtsi"
#include "tegra20-cpu-opp-microvolt.dtsi"

/ {
	model = "LG Optimus 2X (P990)";
	compatible = "lg,star", "nvidia,tegra20";
	chassis-type = "handset";

	aliases {
		mmc0 = &sdmmc4;	/* eMMC */
		mmc1 = &sdmmc3; /* uSD slot */
		mmc2 = &sdmmc1; /* Wi-Fi */

		rtc0 = &pmic;
		rtc1 = "/rtc@7000e000";

		serial0 = &uartb; /* Console */
		serial1 = &uartc; /* Bluetooth */
	};

	chosen {
		stdout-path = "serial0:115200n8";

		#address-cells = <1>;
		#size-cells = <1>;

		framebuffer@1f800000 {
			compatible = "simple-framebuffer";
//			reg = <0x1f800000 0x7d0000>;
			memory-region = <&framebuffer_zone>;
			width = <480>;
			height = <800>;
			stride = <(480 * 2)>;
			format = "r5g6b5";
			clocks = <&tegra_car TEGRA20_CLK_DISP1>;
		};
	};

	memory@0 {
		reg = <0x00000000 0x20000000>; /* 512 MB */
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		linux,cma@0 {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00000000 0x10000000>;
			size = <0x8000000>; /* 128MiB */
			linux,cma-default;
			reusable;
		};

		framebuffer_zone: framebuffer@1f800000 {
			reg = <0x1f800000 0x7d0000>;
			no-map;
		};
	};

	host1x@50000000 {
		hdmi@54280000 {
			status = "okay";

			vdd-supply = <&vdd_3v3_hdmi>;
			pll-supply = <&vcc_hdmi_pll>;
			hdmi-supply = <&vdd_5v0_hdmi>;

			port {
				hdmi_out: endpoint {
					remote-endpoint = <&connector_in>;
				};
			};
		};
	};

//	gpio@6000d000 {
//		test-hog {
//			gpio-hog;
//			gpios = <TEGRA_GPIO(T, 7) GPIO_ACTIVE_HIGH>; // wlan wake GMI_DPD_PT7
//			output-high;
//		};
//	};

	pinmux@70000014 {
		pinctrl-names = "default";
		pinctrl-0 = <&state_default>;

		state_default: pinmux {
			crt {
				nvidia,pins = "crtp";
				nvidia,function = "crt";
			};

			dap1 {
				nvidia,pins = "dap1";
				nvidia,function = "dap1";
			};

			dap2 {
				nvidia,pins = "dap2";
				nvidia,function = "dap2";
			};

			dap3 {
				nvidia,pins = "dap3";
				nvidia,function = "dap3";
			};

			dap4 {
				nvidia,pins = "dap4";
				nvidia,function = "dap4";
			};

			displaya {
				nvidia,pins = "lcsn", "ld0", "ld1", "ld10",
						"ld11", "ld12", "ld13", "ld14",
						"ld15", "ld16", "ld17", "ld2",
						"ld3", "ld4", "ld5", "ld6",
						"ld7", "ld8", "ld9", "ldc",
						"ldi", "lhp0", "lhp1", "lhp2",
						"lhs", "lm0", "lm1", "lpp",
						"lpw0", "lpw1", "lpw2", "lsc0",
						"lsc1", "lsck", "lsda", "lsdi",
						"lspi", "lvp0", "lvp1", "lvs";
				nvidia,function = "displaya";
			};

			gmi {
				nvidia,pins = "ata", "atc", "atd", "ate",
						"gmb", "irrx", "irtx";
				nvidia,function = "gmi";
			};

			hdmi {
				nvidia,pins = "hdint";
				nvidia,function = "hdmi";
			};

			i2cp {
				nvidia,pins = "i2cp";
				nvidia,function = "i2cp";
			};

			rm {
				nvidia,pins = "rm";
				nvidia,function = "i2c1";
			};

			i2c3 {
				nvidia,pins = "dtf";
				nvidia,function = "i2c3";
			};

			kbc {
				nvidia,pins = "kbca", "kbcb", "kbcc", "kbce",
						"kbcf";
				nvidia,function = "kbc";
			};

			owr {
				nvidia,pins = "owc";
				nvidia,function = "owr";
			};

			plla-out {
				nvidia,pins = "cdev1";
				nvidia,function = "plla_out";
			};

			pllp-out4 {
				nvidia,pins = "cdev2";
				nvidia,function = "pllp_out4";
			};

			pwm {
				nvidia,pins = "gpu";
				nvidia,function = "pwm";
			};

			pwr-on {
				nvidia,pins = "pmc";
				nvidia,function = "pwr_on";
			};

			rtck {
				nvidia,pins = "gpu7";
				nvidia,function = "rtck";
			};

			sdio1 {
				nvidia,pins = "sdio1";
				nvidia,function = "sdio1";
			};

			sdio2 {
				nvidia,pins = "kbcd";
				nvidia,function = "sdio2";
			};

			sdio3 {
				nvidia,pins = "sdb", "sdc", "sdd", "slxa",
						"slxd", "slxk", "slxc";
				nvidia,function = "sdio3";
			};

			sdio4 {
				nvidia,pins = "atb", "gma", "gme";
				nvidia,function = "sdio4";
			};

			spi1 {
				nvidia,pins = "uda";
				nvidia,function = "spi1";
			};

			spi2 {
				nvidia,pins = "spia", "spib", "spic";
				nvidia,function = "spi2";
			};

			spi2-alt {
				nvidia,pins = "spid", "spie", "spig", "spih";
				nvidia,function = "spi2_alt";
			};

			uarta {
				nvidia,pins = "uaa", "uab";
				nvidia,function = "uarta";
			};

			uartc {
				nvidia,pins = "uca", "ucb";
				nvidia,function = "uartc";
			};

			uartd {
				nvidia,pins = "gmc";
				nvidia,function = "uartd";
			};

			vi {
				nvidia,pins = "dtc", "dtd";
				nvidia,function = "vi";
			};

			vi-sensor-clk {
				nvidia,pins = "csus";
				nvidia,function = "vi_sensor_clk";
			};

#if 0 // TODO: adjust to kernel
			conf-lsda {
				nvidia,pins = "lsda", "owc";
				nvidia,pull = <TEGRA_PIN_PULL_UP>;
